{
  "name": "progress",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "PROGRESS — a Personal Life Operating System (desktop, offline-first).",
  "scripts": {
    "start": "node server/plans/start.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "plans:server": "node --env-file=.env.plans server/plans/start.mjs",
    "plans:setup": "node --env-file=.env.plans server/plans/setup.mjs",
    "plans:demo": "node server/plans/demo.mjs",
    "plans:test": "node --test tests/plans/*.test.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
