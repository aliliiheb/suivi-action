    "@react-three/postprocessing": "^2.19.1",
    "@tauri-apps/api": "^2.1.1",
    "@tauri-apps/plugin-sql": "^2.0.1",
    "adm-zip": "^0.6.1",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "docx": "^9.7.1",
    "drizzle-orm": "^0.36.4",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "express-session": "^1.19.0",
    "fast-xml-parser": "^5.11.1",
    "helmet": "^8.3.0",
    "i18next": "^23.16.8",
    "i18next-browser-languagedetector": "^8.0.0",
