    "sql.js": "^1.12.0",
    "tailwind-merge": "^2.5.5",
    "three": "^0.169.0",
    "ulid": "^2.3.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.49.0",
    "@tauri-apps/cli": "^2.1.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
